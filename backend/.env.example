# Copy this file to .env and fill in your own values.
# This example is for local development only.
# NEVER commit .env to git.

# Database connection. SQLite is the default for local testing.
# Do not put the online Neon DATABASE_URL in this committed example.
# For MySQL use something like: mysql+pymysql://root:YOUR_PASSWORD@localhost/reading_db
# For PostgreSQL use something like: postgresql+psycopg://USER:PASSWORD@HOST:5432/DB
DATABASE_URL=sqlite:///./dev.db

# Comma-separated frontend URLs allowed to call the API.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Google AI Studio — get your own key at https://aistudio.google.com
# DO NOT paste a real key here; put it only in your local .env.
GOOGLE_API_KEY=

# Gemini model selection (override without code changes)
GEMINI_MODEL=gemini-2.5-flash-lite

# Public study deployment. Leave false for local development.
# Online values should be set in Render, not committed here.
REQUIRE_STUDY_CODE=false
STUDY_INVITE_CODES=

# Public study accounts are pre-created with Study ID + password.
# Keep this false online so visitors cannot create extra accounts.
ALLOW_SELF_REGISTRATION=false

# Local demo accounts.
# These are only for local team testing. Choose your own local password.
SEED_TEST_ACCOUNTS=true
SEED_TEST_PASSWORD=your-local-test-password
RESET_TEAM_ACCOUNT_DATA=false
SEED_PARTICIPANT_ACCOUNTS=false

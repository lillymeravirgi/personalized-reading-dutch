# Copy this to .env for local running. Keep .env private.

# Local database. Teammates can leave this as-is.
DATABASE_URL=sqlite:///./dev.db

# Local frontend addresses allowed to call the backend.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Add your own Gemini key here.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Local demo accounts. Pick any local password.
SEED_TEST_ACCOUNTS=true
SEED_TEST_PASSWORD=your-local-test-password
RESET_TEAM_ACCOUNT_DATA=false

# Optional: fill this only when downloading study data through the helper script.
EXPORT_API_BASE_URL=
